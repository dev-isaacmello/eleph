# A politica do suporte de assinaturas, escrita de forma conferivel.
#
# Duas regras que qualquer time de suporte tem por escrito em algum lugar, e
# que nenhum sistema costuma checar:
#
#   1. So cancela quem esta ativo.
#   2. So reembolsa cobranca que existe, ainda nao foi reembolsada, e cujo
#      cliente ja cancelou.
#
# `eleph check` prova as duas para todo historico antes de qualquer agente
# encostar nelas.

program suporte

sort User
sort Charge

event subscribed(u: User)
event cancelled(u: User)
# A cobranca guarda, na propria identidade, se ela caiu antes ou depois do
# cancelamento. Sem isso a politica tem uma brecha: cancelar hoje tornaria
# reembolsavel uma cobranca de tres meses atras, e o agente chega la sozinho
# fazendo duas coisas permitidas em sequencia.
event charged_while_active(u: User, c: Charge)
event charged_after_cancelling(u: User, c: Charge)
event refunded(u: User, c: Charge)
event settled(u: User, c: Charge)
event statement_closed(u: User)

# Ativo quem assinou e nao cancelou desde entao. Nao existe campo `status`
# em lugar nenhum: a resposta e uma consulta ao que aconteceu.
fact active(U: User) := subscribed(U) since_not cancelled(U)

# Cobranca em aberto: ocorreu e nao foi reembolsada desde entao.
fact outstanding(U: User, C: Charge) := charged_while_active(U, C) since_not refunded(U, C)

# Reembolsavel: caiu depois do cancelamento e ainda nao foi devolvida. O que
# torna uma cobranca reembolsavel e quando ela ocorreu, nao o estado da conta
# no momento em que alguem pergunta.
fact refundable(U: User, C: Charge) := charged_after_cancelling(U, C) since_not refunded(U, C)

# O dinheiro voltou de fato, o que e diferente de ter sido autorizado.
fact settled_back(U: User, C: Charge) := settled(U, C) since_not refunded(U, C)

on question(A, active(U)):
    answer A with active(U)

on question(A, refundable(U, C)):
    answer A with refundable(U, C)

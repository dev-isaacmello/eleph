# A politica do suporte de assinaturas, escrita de forma conferivel.
#
# Tres regras que qualquer time de suporte tem por escrito em algum lugar, e
# que praticamente nenhum sistema checa:
#
#   1. So responde sobre a conta de alguem quem se autenticou naquela conta.
#   2. So cancela quem esta ativo.
#   3. So reembolsa cobranca que caiu depois do cancelamento, ainda nao
#      devolvida, e dentro da alcada do atendente.
#
# `eleph check` prova as tres para todo historico antes de qualquer agente
# encostar nelas.

program suporte

sort User
sort Charge

event autenticou(quem: Party, u: User)
event deslogou(quem: Party, u: User)

event subscribed(u: User)
event cancelled(u: User)
event refunded(u: User, c: Charge)
event settled(u: User, c: Charge)
event statement_closed(u: User)
event escalated(u: User, c: Charge)

# A cobranca guarda, na propria identidade, se caiu antes ou depois do
# cancelamento, e quanto foi. Sem a primeira parte a politica tem brecha:
# cancelar hoje tornaria reembolsavel uma cobranca de tres meses atras.
event charged_while_active(u: User, c: Charge, amount: Number)
event charged_after_cancelling(u: User, c: Charge, amount: Number)

# Quem esta falando tem direito de falar sobre esta conta. Nao e sobre a
# resposta ser verdadeira: e sobre esta pessoa poder ouvi-la. Um atendente que
# informa com toda honestidade a conta de terceiro nao mentiu, e ainda assim e
# um incidente.
fact autorizado(Q: Party, U: User) := autenticou(Q, U) since_not deslogou(Q, U)

fact active(U: User) := subscribed(U) since_not cancelled(U)

# Reembolsavel: caiu depois do cancelamento e ainda nao voltou.
fact refundable(U: User, C: Charge) := charged_after_cancelling(U, C, amount > 0) since_not refunded(U, C)

# Alcada do atendente. Acima disso nao se recusa: escala.
fact within_limit(U: User, C: Charge) := charged_after_cancelling(U, C, amount <= 200) since_not refunded(U, C)

fact may_refund(U: User, C: Charge) := refundable(U, C) and within_limit(U, C)
fact needs_escalation(U: User, C: Charge) := refundable(U, C) and not within_limit(U, C)

fact settled_back(U: User, C: Charge) := settled(U, C) since_not refunded(U, C)

on question(Quem, active(U)) permitted autorizado(Quem, U):
    answer Quem with active(U)

on question(Quem, may_refund(U, C)) permitted autorizado(Quem, U):
    answer Quem with may_refund(U, C)

on question(Quem, needs_escalation(U, C)) permitted autorizado(Quem, U):
    answer Quem with needs_escalation(U, C)

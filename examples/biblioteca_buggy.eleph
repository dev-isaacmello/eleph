# A mesma biblioteca, com o defeito de agente mais comum: aceita a devolucao
# e promete que o livro voltou para a estante, mas nao registra a devolucao.
# O livro continua emprestado para o log, e a promessa e falsa.

program biblioteca

event checkout(book)
event checkin(book)

fact on_loan(B) := checkout(B) since_not checkin(B)

on question(Caller, on_loan(B)):
    answer Caller with on_loan(B)

on request(Caller, checkout(B)):
    if on_loan(B):
        decline Caller
    else:
        record checkout(B)
        accept Caller
        promise Caller that on_loan(B)

on request(Caller, checkin(B)):
    if on_loan(B):
        accept Caller
        promise Caller that not on_loan(B)
    else:
        decline Caller
